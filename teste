>\n  <rect width=\"300\" height=\"300\" fill=\"var(--wall)\"/><rect y=\"230\" width=\"300\" height=\"70\" fill=\"var(--floor)\"/><use href=\"#bar0\"/>\n  <text x=\"150\" y=\"23\" text-anchor=\"middle\" font-size=\"15\" font-weight=\"700\" fill=\"#fff\">CALIBRAÇÃO VENCIDA OU AUSENTE<\/text>\n  <g class=\"it\"><use href=\"#bal\" transform=\"translate(150,140) scale(1.4)\"/><\/g>\n  <g class=\"tl\" style=\"transition-delay:1s\"><rect x=\"105\" y=\"194\" width=\"90\" height=\"38\" rx=\"4\" fill=\"#fff\" stroke=\"var(--red)\" stroke-width=\"3\"/><text x=\"150\" y=\"210\" text-anchor=\"middle\" font-size=\"10\" font-weight=\"700\" fill=\"#16303a\">CALIBRAÇÃO<\/text><text x=\"150\" y=\"225\" text-anchor=\"middle\" font-size=\"11\" fill=\"#16303a\">Val.: 03/2026<\/text><\/g>\n  <g class=\"sg\"><g transform=\"rotate(-12 150 214)\"><rect x=\"92\" y=\"198\" width=\"116\" height=\"34\" rx=\"6\" fill=\"none\" stroke=\"var(--red)\" stroke-width=\"4\"/><text x=\"150\" y=\"224\" text-anchor=\"middle\" font-size=\"22\" font-weight=\"800\" fill=\"var(--red)\">VENCIDA<\/text><\/g><\/g>\n  <g class=\"sg\"><rect x=\"55\" y=\"248\" width=\"190\" height=\"34\" rx=\"17\" fill=\"var(--red)\"/><text x=\"150\" y=\"270\" text-anchor=\"middle\" font-size=\"14\" font-weight=\"700\" fill=\"#fff\">SEM CALIBRAÇÃO: NÃO USAR<\/text><\/g>\n<\/g>\n\n<!-- 3 perigo -->\n<g class=\"sc\" id=\"s3\">\n  <rect width=\"300\" height=\"300\" fill=\"var(--wall)\"/><use href=\"#bar0\"/>\n  <text x=\"150\" y=\"23\" text-anchor=\"middle\" font-size=\"15\" font-weight=\"700\" fill=\"#fff\">O PERIGO<\/text>\n  <g class=\"tl\" style=\"transition-delay:.3s\"><rect x=\"20\" y=\"48\" width=\"260\" height=\"58\" rx=\"12\" fill=\"var(--card)\" stroke=\"var(--red)\" stroke-width=\"3\"/><text x=\"150\" y=\"83\" text-anchor=\"middle\" font-size=\"15\" font-weight=\"700\" fill=\"var(--ink)\">Medição incorreta<\/text><\/g>\n  <g class=\"tl\" style=\"transition-delay:.9s\"><path d=\"M138 110 l12 12 l12 -12\" stroke=\"var(--red)\" stroke-width=\"5\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><\/g>\n  <g class=\"tl\" style=\"transition-delay:1.5s\"><rect x=\"20\" y=\"128\" width=\"260\" height=\"58\" rx=\"12\" fill=\"var(--card)\" stroke=\"var(--red)\" stroke-width=\"3\"/><text x=\"150\" y=\"163\" text-anchor=\"middle\" font-size=\"15\" font-weight=\"700\" fill=\"var(--ink)\">Produto fora de especificação<\/text><\/g>\n  <g class=\"tl\" style=\"transition-delay:2.1s\"><path d=\"M138 190 l12 12 l12 -12\" stroke=\"var(--red)\" stroke-width=\"5\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><\/g>\n  <g class=\"tl\" style=\"transition-delay:2.7s\"><rect x=\"20\" y=\"208\" width=\"260\" height=\"58\" rx=\"12\" fill=\"var(--red)\"/><text x=\"150\" y=\"233\" text-anchor=\"middle\" font-size=\"15\" font-weight=\"800\" fill=\"#fff\">Lote reprovado<\/text><text x=\"150\" y=\"252\" text-anchor=\"middle\" font-size=\"13\" font-weight=\"700\" fill=\"#fff\">e risco ao paciente<\/text><\/g>\n<\/g>\n\n<!-- 4 pare e sinalize -->\n<g class=\"sc\" id=\"s4\">\n  <rect width=\"300\" height=\"300\" fill=\"var(--wall)\"/><rect y=\"230\" width=\"300\" height=\"70\" fill=\"var(--floor)\"/><use href=\"#bar0\"/>\n  <text x=\"150\" y=\"23\" text-anchor=\"middle\" font-size=\"15\" font-weight=\"700\" fill=\"#fff\">PARE E SINALIZE<\/text>\n  <g class=\"tl\"><use href=\"#bal\" transform=\"translate(190,150) scale(1.2)\" opacity=\".6\"/><\/g>\n  <g class=\"sg\"><polygon points=\"73,78.6 91.4,97 91.4,123 73,141.4 47,141.4 28.6,123 28.6,97 47,78.6\" fill=\"var(--red)\" stroke=\"#fff\" stroke-width=\"3\"/><text x=\"60\" y=\"116\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"800\" fill=\"#fff\">PARE<\/text><\/g>\n  <g class=\"tl\" style=\"transition-delay:1.6s\"><g class=\"swing\"><line x1=\"190\" y1=\"191\" x2=\"190\" y2=\"206\" stroke=\"#6b7f88\" stroke-width=\"3\"/><rect x=\"156\" y=\"206\" width=\"68\" height=\"44\" rx=\"5\" fill=\"var(--red)\" stroke=\"#fff\" stroke-width=\"2\"/><text x=\"190\" y=\"225\" text-anchor=\"middle\" font-size=\"12\" font-weight=\"800\" fill=\"#fff\">FORA DE<\/text><text x=\"190\" y=\"241\" text-anchor=\"middle\" font-size=\"12\" font-weight=\"800\" fill=\"#fff\">USO<\/text><\/g><\/g>\n<\/g>\n\n<!-- 5 comunique -->\n<g class=\"sc\" id=\"s5\">\n  <rect width=\"300\" height=\"300\" fill=\"var(--wall)\"/><use href=\"#bar0\"/>\n  <text x=\"150\" y=\"23\" text-anchor=\"middle\" font-size=\"15\" font-weight=\"700\" fill=\"#fff\">COMUNIQUE<\/text>\n  <g class=\"tl\"><circle cx=\"45\" cy=\"78\" r=\"13\" fill=\"#f1c9a5\"/><rect x=\"29\" y=\"93\" width=\"32\" height=\"44\" rx=\"10\" fill=\"#4f7cac\"/><text x=\"45\" y=\"154\" text-anchor=\"middle\" font-size=\"11\" fill=\"var(--mut)\">Você<\/text><\/g>\n  <g class=\"it\" style=\"transition-delay:.5s\"><rect x=\"94\" y=\"94\" width=\"40\" height=\"28\" rx=\"4\" fill=\"#fff\" stroke=\"var(--acc)\" stroke-width=\"3\"/><path d=\"M95 96 l19 14 l19 -14\" fill=\"none\" stroke=\"var(--acc)\" stroke-width=\"3\"/><\/g>\n  <g class=\"tl\" style=\"transition-delay:1s\"><path d=\"M70 108 h20 M138 108 h28\" stroke=\"var(--acc)\" stroke-width=\"4\" stroke-dasharray=\"6 5\" stroke-linecap=\"round\"/><\/g>\n  <g class=\"tl\" style=\"transition-delay:1.4s\"><rect x=\"172\" y=\"62\" width=\"112\" height=\"92\" rx=\"10\" fill=\"var(--card)\" stroke=\"var(--acc)\" stroke-width=\"3\"/><text x=\"228\" y=\"102\" text-anchor=\"middle\" font-size=\"14\" font-weight=\"800\" fill=\"var(--ink)\">METROLOGIA<\/text><text x=\"228\" y=\"122\" text-anchor=\"middle\" font-size=\"14\" font-weight=\"800\" fill=\"var(--ink)\">/ VALIDAÇÃO<\/text><\/g>\n  <rect x=\"14\" y=\"170\" width=\"272\" height=\"118\" rx=\"12\" fill=\"var(--card)\" stroke=\"var(--mut)\" stroke-width=\"2\"/>\n  <g class=\"tl\" style=\"transition-delay:2s\"><text x=\"28\" y=\"192\" font-size=\"13\" font-weight=\"800\" fill=\"var(--acc)\">Informe:<\/text><\/g>\n  <g class=\"tl\" style=\"transition-delay:2.5s\"><text x=\"28\" y=\"212\" font-size=\"12.5\" fill=\"var(--ink)\">• Equipamento, TAG e setor<\/text><\/g>\n  <g class=\"tl\" style=\"transition-delay:3s\"><text x=\"28\" y=\"231\" font-size=\"12.5\" fill=\"var(--ink)\">• Data e problema observado<\/text><\/g>\n  <g class=\"tl\" style=\"transition-delay:3.5s\"><text x=\"28\" y=\"250\" font-size=\"12.5\" fill=\"var(--ink)\">• Itens já medidos com ele<\/text><\/g>\n  <g class=\"tl\" style=\"transition-delay:4s\"><text x=\"28\" y=\"272\" font-size=\"12.5\" font-weight=\"700\" fill=\"var(--ink)\">Registre o desvio conforme o POP<\/text><\/g>\n<\/g>\n\n<!-- 6 resumo -->\n<g class=\"sc\" id=\"s6\">\n  <rect width=\"300\" height=\"300\" fill=\"var(--wall)\"/><use href=\"#bar0\"/>\n  <text x=\"150\" y=\"23\" text-anchor=\"middle\" font-size=\"15\" font-weight=\"700\" fill=\"#fff\">ANTES DE USAR, CONFIRA<\/text>\n  <g class=\"tl\" style=\"transition-delay:.2s\"><rect x=\"14\" y=\"48\" width=\"272\" height=\"48\" rx=\"12\" fill=\"var(--card)\" stroke=\"var(--grn)\" stroke-width=\"3\"/><circle cx=\"40\" cy=\"72\" r=\"13\" fill=\"var(--grn)\"/><path d=\"M33 72 l5 6 l9 -11\" stroke=\"#fff\" stroke-width=\"3.5\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><text x=\"63\" y=\"77\" font-size=\"13\" font-weight=\"700\" fill=\"var(--ink)\">Identificação (TAG) presente<\/text><\/g>\n  <g class=\"tl\" style=\"transition-delay:.7s\"><rect x=\"14\" y=\"106\" width=\"272\" height=\"48\" rx=\"12\" fill=\"var(--card)\" stroke=\"var(--grn)\" stroke-width=\"3\"/><circle cx=\"40\" cy=\"130\" r=\"13\" fill=\"var(--grn)\"/><path d=\"M33 130 l5 6 l9 -11\" stroke=\"#fff\" stroke-width=\"3.5\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><text x=\"63\" y=\"135\" font-size=\"13\" font-weight=\"700\" fill=\"var(--ink)\">Calibração dentro da validade<\/text><\/g>\n  <g class=\"tl\" style=\"transition-delay:1.2s\"><rect x=\"14\" y=\"164\" width=\"272\" height=\"48\" rx=\"12\" fill=\"var(--card)\" stroke=\"var(--red)\" stroke-width=\"3\"/