e\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><\/g><g class=\"tl\" style=\"transition-delay:4.2s\"><rect x=\"20\" y=\"220\" width=\"260\" height=\"40\" rx=\"12\" fill=\"var(--card)\" stroke=\"var(--grn)\" stroke-width=\"3\"/><text x=\"150\" y=\"245.0\" text-anchor=\"middle\" font-size=\"14\" font-weight=\"800\" fill=\"var(--ink)\">Fechar o desvio<\/text><\/g><\/g>\n<g class=\"sc\"><rect width=\"300\" height=\"300\" fill=\"var(--wall)\"/><use href=\"#bar0\"/><text x=\"150\" y=\"23\" text-anchor=\"middle\" font-size=\"15\" font-weight=\"700\" fill=\"#fff\">RESUMO<\/text><g class=\"tl\" style=\"transition-delay:0.3s\"><rect x=\"14\" y=\"50\" width=\"272\" height=\"46\" rx=\"12\" fill=\"var(--card)\" stroke=\"var(--grn)\" stroke-width=\"3\"/><circle cx=\"38\" cy=\"73.0\" r=\"13\" fill=\"var(--grn)\"/><path d=\"M32 73.0 l5 6 l9 -11\" stroke=\"#fff\" stroke-width=\"3.5\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><text x=\"62\" y=\"78.0\" text-anchor=\"start\" font-size=\"13\" font-weight=\"700\" fill=\"var(--ink)\">Identifique o desvio<\/text><\/g><g class=\"tl\" style=\"transition-delay:0.9s\"><rect x=\"14\" y=\"106\" width=\"272\" height=\"46\" rx=\"12\" fill=\"var(--card)\" stroke=\"var(--grn)\" stroke-width=\"3\"/><circle cx=\"38\" cy=\"129.0\" r=\"13\" fill=\"var(--grn)\"/><path d=\"M32 129.0 l5 6 l9 -11\" stroke=\"#fff\" stroke-width=\"3.5\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><text x=\"62\" y=\"134.0\" text-anchor=\"start\" font-size=\"13\" font-weight=\"700\" fill=\"var(--ink)\">Comunique na hora<\/text><\/g><g class=\"tl\" style=\"transition-delay:1.5s\"><rect x=\"14\" y=\"162\" width=\"272\" height=\"46\" rx=\"12\" fill=\"var(--card)\" stroke=\"var(--grn)\" stroke-width=\"3\"/><circle cx=\"38\" cy=\"185.0\" r=\"13\" fill=\"var(--grn)\"/><path d=\"M32 185.0 l5 6 l9 -11\" stroke=\"#fff\" stroke-width=\"3.5\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><text x=\"62\" y=\"190.0\" text-anchor=\"start\" font-size=\"13\" font-weight=\"700\" fill=\"var(--ink)\">Registre os fatos<\/text><\/g><g class=\"sg\" style=\"transition-delay:2.2s\"><rect x=\"20.0\" y=\"228\" width=\"260\" height=\"34\" rx=\"17.0\" fill=\"var(--red)\"/><text x=\"150\" y=\"250.0\" text-anchor=\"middle\" font-size=\"13\" font-weight=\"700\" fill=\"#fff\">Nunca esconda um desvio<\/text><\/g><\/g>\n<\/svg>\n<div class=\"prog\"><i id=\"bar\"><\/i><\/div>\n<div class=\"cap-box\"><b id=\"ct\"><\/b><span id=\"cx\"><\/span><\/div>\n<\/div>\n<div class=\"ctl\"><button id=\"pp\">⏸ Pausar<\/button><button class=\"s\" id=\"rs\">↺ Reiniciar<\/button><div class=\"t\" id=\"tm\">0s / 34s<\/div><\/div>\n<p class=\"foot\">Sequência ilustrativa. Siga sempre os POPs e as Boas Práticas de Fabricação (BPF) da sua empresa.<\/p>\n<\/div>\n<script>\nvar D=34,t=0,playing=true,last=null,scene=-1;\nvar S=[[0, \"Algo saiu do esperado?\", \"Qualquer falha ou saída do procedimento é um desvio e precisa ser tratada.\", \"\", \"\"], [3, \"O que é desvio\", \"Resultado fora do esperado, falha de equipamento, erro de procedimento ou evento inesperado.\", \"a\", \"IDENTIFIQUE\"], [10, \"Aja na hora\", \"Contenha a situação, não corrija por conta própria e avise o supervisor e a Garantia da Qualidade.\", \"a\", \"COMUNIQUE\"], [17, \"Registre os fatos\", \"Anote o que, onde, quando, quem e qual lote foi afetado. Sem suposições nem rasuras.\", \"a\", \"REGISTRE\"], [24, \"A Qualidade assume\", \"A Garantia da Qualidade avalia o impacto, investiga a causa raiz e define as ações corretivas e preventivas (CAPA).\", \"a\", \"QUALIDADE\"], [30, \"Resumo\", \"Identifique, comunique e registre. Nunca esconda um desvio: comunicar protege o paciente.\", \"n\", \"ATENÇÃO\"]];\nvar sc=document.querySelectorAll(\".sc\"),ct=document.getElementById(\"ct\"),cx=document.getElementById(\"cx\"),bar=document.getElementById(\"bar\"),tm=document.getElementById(\"tm\"),pp=document.getElementById(\"pp\");\nfunction render(){\n  var i=0;for(var k=0;k<S.length;k++)if(t>=S[k][0])i=k;\n  if(i!==scene){\n    scene=i;ct.textContent=S[i][1];\n    if(S[i][3]){var c=document.createElement(\"em\");c.className=\"chip \"+S[i][3];c.textContent=S[i][4];ct.appendChild(c);}\n    cx.textContent=S[i][2];\n    for(var j=0;j<sc.length;j++)sc[j].classList.toggle(\"on\",j===i);\n  }\n  bar.style.width=(t/D*100)+\"%\";tm.textContent=Math.floor(t)+\"s / \"+D+\"s\";\n}\nfunction frame(ts){\n  if(last===null)last=ts;\n  if(playing){t+=(ts-last)/1000;if(t>=D){t=D;playing=false;pp.textContent=\"▶ Repetir\";}}\n  last=ts;render();requestAnimationFrame(frame);\n}\npp.onclick=function(){\n  if(t>=D){t=0;playing=true;}else{playing=!playing;}\n  pp.textContent=playing?\"⏸ Pausar\":\"▶ Continuar\";\n};\ndocument.getElementById(\"rs\").onclick=function(){t=0;playing=true;pp.textContent=\"⏸ Pausar\";};\nrequestAnimationFrame(frame);\n<\/script>\n<\/body>\n<\/html>\n"}];
const frame=document.getElementById('screen'), nameEl=document.getElementById('name'), statusEl=document.getElementById('status'), toggleBtn=document.getElementById('toggle');
let current=0, paused=false, deadline=0, remaining=0;
function showStatus(){
  const ms=paused?remaining:Math.max(0,deadline-Date.now());
  statusEl.textContent=(current+1)+'/'+playlist.length+' • próximo em '+Math.ceil(ms/1000)+'s';
}
function play(index){
  current=(index+playlist.length)%playlist.length;
  const item=playlist[current];
  paused=false; remaining=item.duration*1000; deadline=Date.now()+remaining;
  nameEl.textContent=item.title; toggleBtn.textContent='⏸ Pausar';
  frame.srcdoc=item.html;
  showStatus();
}
function tick(){
  if(!paused && Date.now()>=deadline) play(current+1);
  showStatus();
}
function pauseToggle(){
  if(!paused){remaining=Math.max(0,deadline-Date.now());paused=true;toggleBtn.textContent='▶ Continuar';nameEl.textContent=playlist[current].title+' — PAUSADO';}
  else{paused=false;deadline=Date.now()+remaining;toggleBtn.textContent='⏸ Pausar';nameEl.textContent=playlist[current].title;}
  showStatus();
}
document.getElementById('next').onclick=()=>play(current+1);
document.getElementById('prev').onclick=()=>play(current-1);
toggleBtn.onclick=pauseToggle;
document.addEventListener('keydown',e=>{
  if(e.code==='Space'){e.preventDefault();pauseToggle();}
  else if(e.key==='ArrowRight'||e.key.toLowerCase()==='n')play(current+1);
  else if(e.key==='ArrowLeft'||e.key.toLowerCase()==='b')play(current-1);
});
play(0);
setInterval(tick,250);
</script></body></html>
